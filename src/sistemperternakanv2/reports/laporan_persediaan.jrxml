<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_persediaan" pageWidth="842" pageHeight="595" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="AllSectionsNoDetail">
    <parameter name="REPORT_TITLE" class="java.lang.String"/><parameter name="COMPANY_NAME" class="java.lang.String"/><parameter name="COMPANY_ADDRESS" class="java.lang.String"/><parameter name="COMPANY_PHONE" class="java.lang.String"/><parameter name="PERIOD_LABEL" class="java.lang.String"/><parameter name="FILTER_LABEL" class="java.lang.String"/><parameter name="PRINTED_AT" class="java.lang.String"/><parameter name="PRINTED_BY" class="java.lang.String"/>
    <parameter name="GOAT_COUNT" class="java.lang.String"/><parameter name="GOAT_VALUE" class="java.math.BigDecimal"/><parameter name="FEED_VALUE" class="java.math.BigDecimal"/><parameter name="TOTAL_VALUE" class="java.math.BigDecimal"/><parameter name="NOTE" class="java.lang.String"/>
    <field name="code" class="java.lang.String"/><field name="supplier_name" class="java.lang.String"/><field name="pen_name" class="java.lang.String"/><field name="latest_weight" class="java.math.BigDecimal"/><field name="health_status" class="java.lang.String"/><field name="sale_readiness" class="java.lang.String"/><field name="acquisition_cost" class="java.math.BigDecimal"/>
    <title><band height="70">
        <textField><reportElement x="0" y="0" width="782" height="20" forecolor="#166534"/><textElement><font fontName="SansSerif" size="15" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="20" width="782" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_ADDRESS} + "   " + $P{COMPANY_PHONE}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="36" width="782" height="18"/><textElement><font fontName="SansSerif" size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="54" width="782" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Dicetak: " + $P{PRINTED_AT} + " oleh " + $P{PRINTED_BY} + " | " + $P{PERIOD_LABEL} + " | " + $P{FILTER_LABEL}]]></textFieldExpression></textField>
    </band></title>
    <columnHeader><band height="20">
        <rectangle><reportElement x="0" y="0" width="782" height="20" forecolor="#FFFFFF" backcolor="#166534" mode="Opaque"/></rectangle>
        <staticText><reportElement x="3" y="4" width="70" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Kode]]></text></staticText>
        <staticText><reportElement x="73" y="4" width="130" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Supplier]]></text></staticText>
        <staticText><reportElement x="203" y="4" width="110" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Kandang]]></text></staticText>
        <staticText><reportElement x="313" y="4" width="70" height="12" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Berat kg]]></text></staticText>
        <staticText><reportElement x="383" y="4" width="90" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Kesehatan]]></text></staticText>
        <staticText><reportElement x="473" y="4" width="90" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Kelayakan]]></text></staticText>
        <staticText><reportElement x="563" y="4" width="100" height="12" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Nilai Perolehan]]></text></staticText>
        <staticText><reportElement x="663" y="4" width="116" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Catatan]]></text></staticText>
    </band></columnHeader>
    <detail><band height="17">
        <textField><reportElement x="3" y="2" width="70" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{code}]]></textFieldExpression></textField>
        <textField><reportElement x="73" y="2" width="130" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{supplier_name}]]></textFieldExpression></textField>
        <textField><reportElement x="203" y="2" width="110" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{pen_name}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00"><reportElement x="313" y="2" width="70" height="12"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{latest_weight}]]></textFieldExpression></textField>
        <textField><reportElement x="383" y="2" width="90" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{health_status}]]></textFieldExpression></textField>
        <textField><reportElement x="473" y="2" width="90" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{sale_readiness}]]></textFieldExpression></textField>
        <textField pattern="Rp #,##0"><reportElement x="563" y="2" width="100" height="12"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{acquisition_cost}]]></textFieldExpression></textField>
        <textField><reportElement x="663" y="2" width="116" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[""]]></textFieldExpression></textField>
    </band></detail>
    <pageFooter><band height="18"><textField><reportElement x="0" y="3" width="400" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_LABEL} + " | " + $P{FILTER_LABEL}]]></textFieldExpression></textField><textField><reportElement x="560" y="3" width="100" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression></textField><textField evaluationTime="Report"><reportElement x="660" y="3" width="122" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[" dari " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
    <summary><band height="64">
        <line><reportElement x="0" y="2" width="782" height="1" forecolor="#CBD5E1"/></line>
        <textField><reportElement x="3" y="8" width="400" height="14"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Jumlah kambing aktif: " + $P{GOAT_COUNT}]]></textFieldExpression></textField>
        <textField><reportElement x="463" y="8" width="300" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Nilai kambing: " + $P{GOAT_VALUE}]]></textFieldExpression></textField>
        <textField><reportElement x="463" y="20" width="300" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Nilai pakan: " + $P{FEED_VALUE}]]></textFieldExpression></textField>
        <textField><reportElement x="463" y="34" width="300" height="14" forecolor="#166534"/><textElement textAlignment="Right"><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["TOTAL: " + $P{TOTAL_VALUE}]]></textFieldExpression></textField>
        <textField><reportElement x="3" y="50" width="782" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{NOTE}]]></textFieldExpression></textField>
    </band></summary>
    
    
<noData><band height="60"><textField><reportElement x="0" y="20" width="782" height="18"/><textElement textAlignment="Center"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Tidak ada data untuk filter yang dipilih"]]></textFieldExpression></textField></band></noData>
</jasperReport>
