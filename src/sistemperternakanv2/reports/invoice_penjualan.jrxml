<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="invoice_penjualan" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS" class="java.lang.String"/>
    <parameter name="COMPANY_PHONE" class="java.lang.String"/>
    <parameter name="PERIOD_LABEL" class="java.lang.String"/>
    <parameter name="FILTER_LABEL" class="java.lang.String"/>
    <parameter name="PRINTED_AT" class="java.lang.String"/>
    <parameter name="PRINTED_BY" class="java.lang.String"/>
    <parameter name="DOC_NO" class="java.lang.String"/>
    <parameter name="PARTY_NAME" class="java.lang.String"/>
    <parameter name="DOC_DATE" class="java.lang.String"/>
    <parameter name="TOTAL_NET" class="java.math.BigDecimal"/>
    <parameter name="NOTE" class="java.lang.String"/>
    <field name="goat_code" class="java.lang.String"/>
    <field name="method" class="java.lang.String"/>
    <field name="weight" class="java.lang.String"/>
    <field name="rate" class="java.math.BigDecimal"/>
    <field name="net" class="java.math.BigDecimal"/>
    <title>
        <band height="112">
            <textField><reportElement x="0" y="0" width="535" height="22" forecolor="#166534"/><textElement><font fontName="SansSerif" size="16" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="22" width="535" height="14" forecolor="#475569"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_ADDRESS} + "   " + $P{COMPANY_PHONE}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="40" width="535" height="1" forecolor="#CBD5E1"/></line>
            <textField><reportElement x="0" y="46" width="300" height="20"/><textElement><font fontName="SansSerif" size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="46" width="185" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["No: " + $P{DOC_NO}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="70" width="350" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Pelanggan: " + $P{PARTY_NAME}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="62" width="185" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Tanggal: " + $P{DOC_DATE}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="86" width="535" height="14" forecolor="#475569"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Dicetak: " + $P{PRINTED_AT} + " oleh " + $P{PRINTED_BY}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="22">
            <rectangle><reportElement x="0" y="0" width="535" height="22" forecolor="#FFFFFF" backcolor="#166534" mode="Opaque"/></rectangle>
            <staticText><reportElement x="4" y="5" width="95" height="14" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[Kode Kambing]]></text></staticText>
            <staticText><reportElement x="104" y="5" width="70" height="14" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[Metode]]></text></staticText>
            <staticText><reportElement x="179" y="5" width="60" height="14" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[Berat (kg)]]></text></staticText>
            <staticText><reportElement x="244" y="5" width="85" height="14" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[Tarif]]></text></staticText>
            <staticText><reportElement x="334" y="5" width="197" height="14" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[Jumlah Bersih]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField><reportElement x="4" y="3" width="95" height="14"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{goat_code}]]></textFieldExpression></textField>
            <textField><reportElement x="104" y="3" width="70" height="14"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{method}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="179" y="3" width="60" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{weight}]]></textFieldExpression></textField>
            <textField pattern="Rp #,##0"><reportElement x="244" y="3" width="85" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{rate}]]></textFieldExpression></textField>
            <textField pattern="Rp #,##0"><reportElement x="334" y="3" width="197" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{net}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="20">
            <textField><reportElement x="0" y="4" width="400" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_LABEL} + " | " + $P{FILTER_LABEL}]]></textFieldExpression></textField>
            <textField><reportElement x="310" y="4" width="100" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression></textField><textField evaluationTime="Report"><reportElement x="410" y="4" width="125" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[" dari " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
    <summary>
        <band height="70">
            <line><reportElement x="0" y="4" width="535" height="1" forecolor="#CBD5E1"/></line>
            <textField pattern="Rp #,##0"><reportElement x="334" y="10" width="197" height="18"/><textElement textAlignment="Right"><font fontName="SansSerif" size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["TOTAL: " + $P{TOTAL_NET}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="50" width="535" height="14" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{NOTE}]]></textFieldExpression></textField>
        </band>
    </summary>
    
    
<noData>
        <band height="60"><textField><reportElement x="0" y="20" width="535" height="18"/><textElement textAlignment="Center"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Tidak ada data untuk filter yang dipilih"]]></textFieldExpression></textField></band>
    </noData>
</jasperReport>
