<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laba_rugi_periode" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="AllSectionsNoDetail">
    <parameter name="REPORT_TITLE" class="java.lang.String"/><parameter name="COMPANY_NAME" class="java.lang.String"/><parameter name="COMPANY_ADDRESS" class="java.lang.String"/><parameter name="COMPANY_PHONE" class="java.lang.String"/><parameter name="PERIOD_LABEL" class="java.lang.String"/><parameter name="FILTER_LABEL" class="java.lang.String"/><parameter name="PRINTED_AT" class="java.lang.String"/><parameter name="PRINTED_BY" class="java.lang.String"/><parameter name="REVENUE" class="java.math.BigDecimal"/><parameter name="HPP" class="java.math.BigDecimal"/><parameter name="GROSS_MARGIN" class="java.math.BigDecimal"/><parameter name="EXPENSES" class="java.math.BigDecimal"/><parameter name="FEED_USAGE" class="java.math.BigDecimal"/><parameter name="LOSSES" class="java.math.BigDecimal"/><parameter name="PERIOD_RESULT" class="java.math.BigDecimal"/><parameter name="MARGIN_PERCENT" class="java.math.BigDecimal"/><parameter name="NOTE" class="java.lang.String"/>
    <field name="label" class="java.lang.String"/><field name="amount" class="java.math.BigDecimal"/>
    <title><band height="92">
        <textField><reportElement x="0" y="0" width="535" height="20" forecolor="#166534"/><textElement><font fontName="SansSerif" size="15" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="20" width="535" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_ADDRESS} + "   " + $P{COMPANY_PHONE}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="36" width="535" height="18"/><textElement><font fontName="SansSerif" size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="54" width="535" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Dicetak: " + $P{PRINTED_AT} + " oleh " + $P{PRINTED_BY} + " | " + $P{PERIOD_LABEL} + " | " + $P{FILTER_LABEL}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="72" width="535" height="14"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Penjualan bersih: " + $P{REVENUE} + " | HPP: " + $P{HPP} + " | Laba kotor: " + $P{GROSS_MARGIN}]]></textFieldExpression></textField>
    </band></title>
    <columnHeader><band height="20">
        <rectangle><reportElement x="0" y="0" width="535" height="20" forecolor="#FFFFFF" backcolor="#166534" mode="Opaque"/></rectangle>
        <staticText><reportElement x="4" y="4" width="400" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[Komponen Rekonsiliasi]]></text></staticText>
        <staticText><reportElement x="404" y="4" width="127" height="12" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[Nominal]]></text></staticText>
    </band></columnHeader>
    <detail><band height="22">
        <textField><reportElement x="4" y="4" width="400" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{label}]]></textFieldExpression></textField>
        <textField pattern="Rp #,##0;Rp -#,##0"><reportElement x="404" y="4" width="127" height="14"/><textElement textAlignment="Right"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
    </band></detail>
    <pageFooter><band height="18"><textField><reportElement x="0" y="3" width="400" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_LABEL} + " | " + $P{FILTER_LABEL}]]></textFieldExpression></textField><textField><reportElement x="310" y="3" width="100" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression></textField><textField evaluationTime="Report"><reportElement x="410" y="3" width="125" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[" dari " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
    <summary><band height="100">
        <line><reportElement x="0" y="2" width="535" height="1" forecolor="#CBD5E1"/></line>
        <textField><reportElement x="4" y="10" width="400" height="16"/><textElement><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Beban operasional/penjualan: " + $P{EXPENSES}]]></textFieldExpression></textField>
        <textField><reportElement x="4" y="28" width="400" height="16"/><textElement><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Beban pakan (pemakaian): " + $P{FEED_USAGE}]]></textFieldExpression></textField>
        <textField><reportElement x="4" y="46" width="400" height="16"/><textElement><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Kerugian persediaan: " + $P{LOSSES}]]></textFieldExpression></textField>
        <textField><reportElement x="4" y="66" width="400" height="18" forecolor="#166534"/><textElement><font fontName="SansSerif" size="12" isBold="true"/></textElement><textFieldExpression><![CDATA["LABA RUGI PERIODE: " + $P{PERIOD_RESULT}]]></textFieldExpression></textField>
        <textField><reportElement x="4" y="84" width="535" height="14" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{NOTE}]]></textFieldExpression></textField>
