<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rekap_keuntungan_kerugian" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="AllSectionsNoDetail">
    <parameter name="REPORT_TITLE" class="java.lang.String"/><parameter name="COMPANY_NAME" class="java.lang.String"/><parameter name="COMPANY_ADDRESS" class="java.lang.String"/><parameter name="COMPANY_PHONE" class="java.lang.String"/><parameter name="PERIOD_LABEL" class="java.lang.String"/><parameter name="FILTER_LABEL" class="java.lang.String"/><parameter name="PRINTED_AT" class="java.lang.String"/><parameter name="PRINTED_BY" class="java.lang.String"/><parameter name="SOLD_COUNT" class="java.lang.String"/><parameter name="PROFIT_COUNT" class="java.lang.String"/><parameter name="LOSS_COUNT" class="java.lang.String"/><parameter name="TOTAL_PROFIT" class="java.math.BigDecimal"/><parameter name="AVG_PROFIT" class="java.math.BigDecimal"/><parameter name="NOTE" class="java.lang.String"/>
    <field name="code" class="java.lang.String"/><field name="sale_date" class="java.lang.String"/><field name="revenue" class="java.math.BigDecimal"/><field name="hpp" class="java.math.BigDecimal"/><field name="direct_cost" class="java.math.BigDecimal"/><field name="allocated_cost" class="java.math.BigDecimal"/><field name="profit" class="java.math.BigDecimal"/><field name="margin_percent" class="java.math.BigDecimal"/><field name="snapshot_status" class="java.lang.String"/>
    <title><band height="78">
        <textField><reportElement x="0" y="0" width="535" height="20" forecolor="#166534"/><textElement><font fontName="SansSerif" size="15" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="20" width="535" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_ADDRESS} + "   " + $P{COMPANY_PHONE}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="36" width="535" height="18"/><textElement><font fontName="SansSerif" size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="54" width="535" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Dicetak: " + $P{PRINTED_AT} + " oleh " + $P{PRINTED_BY} + " | " + $P{PERIOD_LABEL} + " | " + $P{FILTER_LABEL}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="66" width="535" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Terjual: " + $P{SOLD_COUNT} + " | Untung: " + $P{PROFIT_COUNT} + " | Rugi: " + $P{LOSS_COUNT} + " | Total laba: " + $P{TOTAL_PROFIT} + " | Rata-rata: " + $P{AVG_PROFIT}]]></textFieldExpression></textField>
    </band></title>
    <columnHeader><band height="20">
        <rectangle><reportElement x="0" y="0" width="535" height="20" forecolor="#FFFFFF" backcolor="#166534" mode="Opaque"/></rectangle>
        <staticText><reportElement x="2" y="4" width="60" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Kode]]></text></staticText>
        <staticText><reportElement x="62" y="4" width="62" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Tanggal Jual]]></text></staticText>
        <staticText><reportElement x="124" y="4" width="78" height="12" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Penjualan]]></text></staticText>
        <staticText><reportElement x="202" y="4" width="68" height="12" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[HPP]]></text></staticText>
        <staticText><reportElement x="270" y="4" width="60" height="12" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Beban]]></text></staticText>
        <staticText><reportElement x="330" y="4" width="70" height="12" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Laba]]></text></staticText>
        <staticText><reportElement x="400" y="4" width="48" height="12" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Margin]]></text></staticText>
        <staticText><reportElement x="448" y="4" width="85" height="12" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="7" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
    </band></columnHeader>
    <detail><band height="18">
        <textField><reportElement x="2" y="3" width="60" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{code}]]></textFieldExpression></textField>
        <textField><reportElement x="62" y="3" width="62" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{sale_date}]]></textFieldExpression></textField>
        <textField pattern="Rp #,##0"><reportElement x="124" y="3" width="78" height="12"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{revenue}]]></textFieldExpression></textField>
        <textField pattern="Rp #,##0"><reportElement x="202" y="3" width="68" height="12"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{hpp}]]></textFieldExpression></textField>
        <textField pattern="Rp #,##0"><reportElement x="270" y="3" width="60" height="12"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{direct_cost}.add($F{allocated_cost})]]></textFieldExpression></textField>
        <textField pattern="Rp #,##0"><reportElement x="330" y="3" width="70" height="12"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{profit}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00"><reportElement x="400" y="3" width="48" height="12"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{margin_percent}]]></textFieldExpression></textField>
        <textField><reportElement x="448" y="3" width="85" height="12"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$F{snapshot_status}]]></textFieldExpression></textField>
    </band></detail>
    <pageFooter><band height="18"><textField><reportElement x="0" y="3" width="400" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_LABEL} + " | " + $P{FILTER_LABEL}]]></textFieldExpression></textField><textField><reportElement x="310" y="3" width="100" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression></textField><textField evaluationTime="Report"><reportElement x="410" y="3" width="125" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[" dari " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
    <summary><band height="40">
        <line><reportElement x="0" y="2" width="535" height="1" forecolor="#CBD5E1"/></line>
        <textField><reportElement x="0" y="8" width="300" height="12"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Total laba manajerial: " + $P{TOTAL_PROFIT}]]></textFieldExpression></textField>
        <textField><reportElement x="0" y="22" width="535" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{NOTE}]]></textFieldExpression></textField>
    </band></summary>
    
    
<noData><band height="60"><textField><reportElement x="0" y="20" width="535" height="18"/><textElement textAlignment="Center"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Tidak ada data untuk filter yang dipilih"]]></textFieldExpression></textField></band></noData>
