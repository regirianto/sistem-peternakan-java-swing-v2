<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="kuitansi_pembayaran" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS" class="java.lang.String"/>
    <parameter name="COMPANY_PHONE" class="java.lang.String"/>
    <parameter name="PERIOD_LABEL" class="java.lang.String"/>
    <parameter name="FILTER_LABEL" class="java.lang.String"/>
    <parameter name="PRINTED_AT" class="java.lang.String"/>
    <parameter name="PRINTED_BY" class="java.lang.String"/>
    <parameter name="DOC_NO" class="java.lang.String"/>
    <parameter name="PARTY_NAME" class="java.lang.String"/>
    <parameter name="DOC_DATE" class="java.lang.String"/>
    <parameter name="AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="METHOD" class="java.lang.String"/>
    <parameter name="ACCOUNT_NAME" class="java.lang.String"/>
    <parameter name="SOURCE_DOC" class="java.lang.String"/>
    <parameter name="NOTE" class="java.lang.String"/>
    <field name="label" class="java.lang.String"/>
    <field name="value" class="java.lang.String"/>
    <title>
        <band height="120">
            <textField><reportElement x="0" y="0" width="535" height="22" forecolor="#166534"/><textElement><font fontName="SansSerif" size="16" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="22" width="535" height="14" forecolor="#475569"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_ADDRESS} + "   " + $P{COMPANY_PHONE}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="42" width="535" height="1" forecolor="#CBD5E1"/></line>
            <textField><reportElement x="0" y="52" width="535" height="22"/><textElement textAlignment="Center"><font fontName="SansSerif" size="15" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="78" width="535" height="16"/><textElement textAlignment="Center"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["No: " + $P{DOC_NO} + "   Tanggal: " + $P{DOC_DATE}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="98" width="535" height="16"/><textElement textAlignment="Center"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Diterima dari / Dibayar kepada: " + $P{PARTY_NAME}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader><band height="10"/></columnHeader>
    <detail>
        <band height="22">
            <textField><reportElement x="40" y="4" width="200" height="14"/><textElement><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{label}]]></textFieldExpression></textField>
            <textField><reportElement x="240" y="4" width="295" height="14"/><textElement><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA[$F{value}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="20">
            <textField><reportElement x="0" y="4" width="400" height="12" forecolor="#475569"/><textElement><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_LABEL} + " | " + $P{FILTER_LABEL}]]></textFieldExpression></textField>
            <textField><reportElement x="310" y="4" width="100" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression></textField><textField evaluationTime="Report"><reportElement x="410" y="4" width="125" height="12" forecolor="#475569"/><textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement><textFieldExpression><![CDATA[" dari " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
    <summary>
        <band height="90">
            <line><reportElement x="40" y="8" width="495" height="1" forecolor="#CBD5E1"/></line>
            <textField pattern="Rp #,##0"><reportElement x="40" y="18" width="495" height="24" forecolor="#166534"/><textElement textAlignment="Center"><font fontName="SansSerif" size="16" isBold="true"/></textElement><textFieldExpression><![CDATA["JUMLAH: " + $P{AMOUNT}]]></textFieldExpression></textField>
            <textField><reportElement x="40" y="52" width="495" height="14" forecolor="#475569"/><textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Metode: " + $P{METHOD} + " | Akun: " + $P{ACCOUNT_NAME} + " | Dokumen: " + $P{SOURCE_DOC}]]></textFieldExpression></textField>
            <textField><reportElement x="40" y="68" width="495" height="14" forecolor="#475569"/><textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$P{NOTE}]]></textFieldExpression></textField>
        </band>
    </summary>
    
    
<noData><band height="60"><textField><reportElement x="0" y="20" width="535" height="18"/><textElement textAlignment="Center"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Tidak ada data untuk filter yang dipilih"]]></textFieldExpression></textField></band></noData>
</jasperReport>
